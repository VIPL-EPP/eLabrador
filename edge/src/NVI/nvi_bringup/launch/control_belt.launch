<launch>
    <include file="$(find nvi_management)/launch/nvi_management.launch" />
    <include file="$(find nvi_bringup)/launch/nvi_realsense.launch" /> 
    <include file="$(find nvi_bringup)/launch/nvi_vio.launch" />
    <include file="$(find nvi_planning)/launch/calibration.launch" />
    <include file="$(find nvi_belt)/launch/nvi_belt.launch" />
    <include file="$(find nvi_voice)/launch/nvi_voice.launch" />
    <include file="$(find nvi_speech)/launch/nvi_speech.launch" />
    <arg name="record_path" default="test.bag"/>
    <node pkg="rosbag" name="data_record" type="record" 
    args="/tf_static /camera/imu 
    /vins_estimator/odometry
    /belt_info
    -O ../Datasets/$(arg record_path)" />
</launch>
