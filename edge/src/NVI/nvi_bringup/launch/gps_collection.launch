<launch>
    <include file="$(find nvi_bringup)/launch/nvi_realsense.launch" />
    <include file="$(find nvi_bringup)/launch/nvi_phone_gps.launch" />
    <include file="$(find nvi_bringup)/launch/nvi_vio.launch" />
    <arg name="record_path" default="test"/>
    <node pkg="rosbag" name="data_record" type="record" 
        args="/tf /tf_static /camera/imu 
        /camera/rgb/camera_info /camera/rgb/image_raw
        /camera/depth/camera_info /camera/depth/image_raw
        /vins_estimator/odometry /vins_estimator/path
        /ublox_driver/receiver_lla /phone_gps/receiver_lla
        -O ../Datasets/$(arg record_path).bag" />
</launch>

        <!-- /global_planning/status /global_planning/target
        /local_planning/belt /local_planning/objects /local_planning/target
        /management/command
        /semanticmap_full /prmap_full -->
