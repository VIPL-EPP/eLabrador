<launch>
    <remap from="/image/rgb" to="/camera/rgb/image_raw" />
    <remap from="/image/depth" to="/camera/depth/image_raw" />
    <remap from="/image/rgbd" to="/camera/rgbd/image_raw" />
    <node pkg="rgbd_transit" name="rgbd_transit" type="rgbd_transit_node" cwd="node" respawn="true" output="screen">
        <param name="rgbd_rate"  type = "double" value="2"/>
    </node>
</launch>