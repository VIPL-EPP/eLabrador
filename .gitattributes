* text=auto

# ROS and configuration files should keep readable diffs.
*.launch text eol=lf
*.urdf text eol=lf
*.xacro text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.msg text eol=lf
*.srv text eol=lf
*.action text eol=lf
*.rviz text eol=lf
*.cmake text eol=lf
*.proto text eol=lf
*.ipynb text eol=lf
*.rules text eol=lf
*.svg text eol=lf
*.xml text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.bash text eol=lf
Makefile text eol=lf
*.cpp text eol=lf
*.cc text eol=lf
*.cxx text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.md text eol=lf

# Binary assets and model artifacts.
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.xlsx binary
*.pkl filter=lfs diff=lfs merge=lfs -text
*.bag filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.engine filter=lfs diff=lfs merge=lfs -text
*.weights filter=lfs diff=lfs merge=lfs -text
*weights filter=lfs diff=lfs merge=lfs -text
