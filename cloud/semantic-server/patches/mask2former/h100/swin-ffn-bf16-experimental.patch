+def _swin_post_attention_ffn_bf16(
+    shortcut,
+    attention_output,
+    norm_weight,
+    norm_bias,
+    norm_eps,
+    fc1_weight_bf16,
+    fc1_bias_bf16,
+    fc2_weight_bf16,
+    fc2_bias_bf16,
+):
+    """Keep residual/norm in FP32 and run only the two MLP GEMMs in BF16."""
+    residual = shortcut + attention_output
+    normalized = F.layer_norm(
+        residual,
+        (residual.shape[-1],),
+        norm_weight,
+        norm_bias,
+        norm_eps,
+    )
+    hidden = F.gelu(
+        F.linear(
+            normalized.to(torch.bfloat16),
+            fc1_weight_bf16,
+            fc1_bias_bf16,
+        )
+    )
+    update = F.linear(hidden, fc2_weight_bf16, fc2_bias_bf16)
+    return residual + update.float()
+
