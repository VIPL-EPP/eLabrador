+def _semantic_batch_postprocess(
+    mask_cls,
+    mask_probabilities,
+    image_height,
+    image_width,
+    output_height,
+    output_width,
+):
+    """Batch semantic query aggregation before the final linear resize."""
+    mask_cls = F.softmax(mask_cls, dim=-1)[..., :-1]
+    mask_probabilities = mask_probabilities[
+        ..., :image_height, :image_width
+    ]
+    batch, queries, height, width = mask_probabilities.shape
+    semseg = torch.bmm(
+        mask_cls.transpose(1, 2),
+        mask_probabilities.reshape(batch, queries, height * width),
+    ).reshape(batch, mask_cls.shape[-1], height, width)
+    return F.interpolate(
+        semseg,
+        size=(output_height, output_width),
+        mode="bilinear",
+        align_corners=False,
+    )
+
+
+_compiled_semantic_batch_postprocess = torch.compile(
+    _semantic_batch_postprocess, dynamic=False, fullgraph=True
+)
