+if _MSDEFORM_FFN_IMPL not in ("legacy", "compiled-bf16"):
+    raise ValueError(
+        "NVI_MSDEFORM_FFN_IMPL must be 'legacy' or 'compiled-bf16', "
+        f"got {_MSDEFORM_FFN_IMPL!r}"
+    )
