+def _msdeform_ffn_bf16(
+    source,
+    linear1_weight_bf16,
+    linear1_bias_bf16,
+    linear2_weight_bf16,
+    linear2_bias_bf16,
+    norm_weight,
+    norm_bias,
+    norm_eps,
+):
+    """Run encoder FFN GEMMs in BF16 and keep residual/LayerNorm in FP32."""
+    hidden = F.relu(
+        F.linear(
+            source.to(torch.bfloat16),
+            linear1_weight_bf16,
+            linear1_bias_bf16,
+        )
+    )
+    update = F.linear(
+        hidden, linear2_weight_bf16, linear2_bias_bf16
+    ).float()
+    return F.layer_norm(
+        source + update,
+        (source.shape[-1],),
+        norm_weight,
+        norm_bias,
+        norm_eps,
+    )
+
+
+_compiled_msdeform_ffn_bf16 = torch.compile(
+    _msdeform_ffn_bf16, dynamic=False, fullgraph=True
