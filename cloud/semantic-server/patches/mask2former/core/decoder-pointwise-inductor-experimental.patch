+_DECODER_POINTWISE_IMPL = os.getenv(
+    "NVI_DECODER_POINTWISE_IMPL", "legacy"
+).strip().lower()
+if _DECODER_POINTWISE_IMPL not in ("legacy", "compiled"):
+    raise ValueError(
+        "NVI_DECODER_POINTWISE_IMPL must be 'legacy' or 'compiled', "
+        f"got {_DECODER_POINTWISE_IMPL!r}"
+    )
+
+
+def _decoder_residual_norm(tgt, update, norm_weight, norm_bias, norm_eps):
+    return F.layer_norm(
+        tgt + update,
+        (tgt.shape[-1],),
+        norm_weight,
+        norm_bias,
+        norm_eps,
+    )
+
+
+def _decoder_ffn_post(
+    tgt,
+    linear1_weight,
+    linear1_bias,
+    linear2_weight,
+    linear2_bias,
+    norm_weight,
+    norm_bias,
+    norm_eps,
+):
+    update = F.linear(
+        F.relu(F.linear(tgt, linear1_weight, linear1_bias)),
+        linear2_weight,
+        linear2_bias,
+    )
+    return _decoder_residual_norm(
+        tgt, update, norm_weight, norm_bias, norm_eps
+    )
+
+
+def _decoder_prediction_heads(
+    output,
+    norm_weight,
+    norm_bias,
+    norm_eps,
+    class_weight,
+    class_bias,
+    mask1_weight,
+    mask1_bias,
+    mask2_weight,
+    mask2_bias,
+    mask3_weight,
+    mask3_bias,
+):
+    decoded = F.layer_norm(
+        output,
+        (output.shape[-1],),
+        norm_weight,
+        norm_bias,
+        norm_eps,
+    ).transpose(0, 1)
+    outputs_class = F.linear(decoded, class_weight, class_bias)
+    mask_embed = F.relu(F.linear(decoded, mask1_weight, mask1_bias))
+    mask_embed = F.relu(F.linear(mask_embed, mask2_weight, mask2_bias))
+    mask_embed = F.linear(mask_embed, mask3_weight, mask3_bias)
+    return outputs_class, mask_embed
+
+
+def _decoder_attention_mask_pointwise(resized_mask, num_heads):
+    return (
+        resized_mask.flatten(2)
+        .unsqueeze(1)
+        .repeat(1, num_heads, 1, 1)
+        .flatten(0, 1)
+        < 0
+    )
+
+
+_compiled_decoder_residual_norm = torch.compile(
+    _decoder_residual_norm, dynamic=False, fullgraph=True
+)
+_compiled_decoder_ffn_post = torch.compile(
+    _decoder_ffn_post, dynamic=False, fullgraph=True
+)
+_compiled_decoder_prediction_heads = torch.compile(
+    _decoder_prediction_heads, dynamic=False, fullgraph=True
+)
+_compiled_decoder_attention_mask_pointwise_by_size = {
+    size: torch.compile(
+        _decoder_attention_mask_pointwise, dynamic=False, fullgraph=True
+    )
+    for size in ((96, 128), (48, 64), (24, 32))
+}
