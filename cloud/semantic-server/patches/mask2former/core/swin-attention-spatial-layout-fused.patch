+def _window_qkv_partition_bf16(
+    qkv,
+    qkv_bias,
+    window_size,
+    shift_size,
+    padded_height,
+    padded_width,
+):
+    """Fuse QKV bias padding, optional roll, partition, and BF16 cast."""
+    batch, height, width, three_channels = qkv.shape
+    if padded_width > width:
+        right = qkv_bias.view(1, 1, 1, three_channels).expand(
+            batch, height, padded_width - width, three_channels
+        )
+        qkv = torch.cat((qkv, right), dim=2)
+    if padded_height > height:
+        bottom = qkv_bias.view(1, 1, 1, three_channels).expand(
+            batch,
+            padded_height - height,
+            padded_width,
+            three_channels,
+        )
+        qkv = torch.cat((qkv, bottom), dim=1)
+    if shift_size > 0:
+        qkv = torch.roll(
+            qkv, shifts=(-shift_size, -shift_size), dims=(1, 2)
+        )
+    qkv = qkv.view(
+        batch,
+        padded_height // window_size,
+        window_size,
+        padded_width // window_size,
+        window_size,
+        three_channels,
+    )
+    return (
+        qkv.permute(0, 1, 3, 2, 4, 5)
+        .reshape(-1, window_size * window_size, three_channels)
+        .to(torch.bfloat16)
+    )
+
+
+def _flex_attention_spatial_fp32(
+    q,
+    k,
+    v,
+    score_mod,
+    scale,
+    window_size,
+    padded_height,
+    padded_width,
+    output_height,
+    output_width,
+    shift_size,
+):
+    """Return attention output directly in cropped BHWC spatial layout."""
+    output = flex_attention(q, k, v, score_mod=score_mod, scale=scale)
+    batch_windows, heads, tokens, head_dim = output.shape
+    windows_per_image = (
+        (padded_height // window_size) * (padded_width // window_size)
+    )
+    batch = batch_windows // windows_per_image
+    output = output.transpose(1, 2).reshape(
+        batch_windows,
+        window_size,
+        window_size,
+        heads * head_dim,
+    )
+    output = output.view(
+        batch,
+        padded_height // window_size,
+        padded_width // window_size,
+        window_size,
+        window_size,
+        heads * head_dim,
+    )
+    output = output.permute(0, 1, 3, 2, 4, 5).reshape(
+        batch, padded_height, padded_width, heads * head_dim
+    )
+    if shift_size > 0:
+        output = torch.roll(
+            output, shifts=(shift_size, shift_size), dims=(1, 2)
+        )
+    return output[:, :output_height, :output_width, :].to(torch.float32)
+
+
+_SPATIAL_LAYOUT_KEYS = tuple(
+    (channels, has_shift)
+    for channels in (192, 384, 768, 1536)
+    for has_shift in (False, True)
+)
+_compiled_window_qkv_partition_bf16_by_key = {
+    key: torch.compile(
+        _window_qkv_partition_bf16, dynamic=False, fullgraph=True
+    )
+    for key in _SPATIAL_LAYOUT_KEYS
+}
+_compiled_flex_attention_spatial_fp32_by_key = {
+    key: torch.compile(
+        _flex_attention_spatial_fp32, dynamic=False, fullgraph=True
+    )
+    for key in _FLEX_ATTENTION_KEYS
+}
+
