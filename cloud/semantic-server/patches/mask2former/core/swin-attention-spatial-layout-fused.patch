+    def forward_spatial(
+        self,
+        qkv_windows,
+        mask,
+        padded_height,
+        padded_width,
+        output_height,
+        output_width,
+        shift_size,
+    ):
+        """Run FlexAttention and return projected, cropped BHWC output."""
+        batch_windows, tokens, three_channels = qkv_windows.shape
+        channels = three_channels // 3
+        qkv = qkv_windows.reshape(
+            batch_windows,
+            tokens,
+            3,
+            self.num_heads,
+            channels // self.num_heads,
+        ).permute(2, 0, 3, 1, 4)
+        q, k, v = qkv[0], qkv[1], qkv[2]
+
+        relative_position_bias = self._relative_position_bias_bf16_cache
+        if (
+            relative_position_bias is None
+            or relative_position_bias.device != q.device
+        ):
+            relative_position_bias = self.relative_position_bias_table[
+                self.relative_position_index.view(-1)
+            ].view(tokens, tokens, self.num_heads)
+            relative_position_bias = (
+                relative_position_bias.permute(2, 0, 1)
+                .contiguous()
+                .to(torch.bfloat16)
+            )
+            self._relative_position_bias_bf16_cache = relative_position_bias
+
+        if mask is None:
+            def score_mod(score, batch, head, query_index, key_index):
+                return score + relative_position_bias[
+                    head, query_index, key_index
+                ]
+        else:
+            attention_mask = self._attention_mask_bf16_cache
+            if (
+                attention_mask is None
+                or attention_mask.device != q.device
+                or attention_mask.shape != mask.shape
+            ):
+                attention_mask = mask.to(torch.bfloat16)
+                self._attention_mask_bf16_cache = attention_mask
+            windows_per_image = mask.shape[0]
+
+            def score_mod(score, batch, head, query_index, key_index):
+                return (
+                    score
+                    + relative_position_bias[head, query_index, key_index]
+                    + attention_mask[
+                        batch % windows_per_image,
+                        query_index,
+                        key_index,
+                    ]
+                )
+
+        flex_key = (self.num_heads, mask is not None)
+        output = _compiled_flex_attention_spatial_fp32_by_key[flex_key](
+            q,
+            k,
+            v,
+            score_mod=score_mod,
+            scale=self.scale,
+            window_size=self.window_size[0],
+            padded_height=padded_height,
+            padded_width=padded_width,
+            output_height=output_height,
+            output_width=output_width,
+            shift_size=shift_size,
+        )
+        output = self.proj(output)
+        return self.proj_drop(output)
+
 
