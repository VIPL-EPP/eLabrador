+    def _device_shapes(self, spatial_shapes, device):
+        """Device copies of the shape metadata, built at most once per shape set.
+
+        MSDeformAttn's CUDA kernel needs int64 device tensors, but rebuilding them on
+        every call cost a blocking 48-byte pageable H2D copy. The inference scale set
+        is fixed, so the first call for a shape set fills the cache and later calls
+        reuse it. Concurrent first calls only duplicate the build, never corrupt it.
+        """
+        key = (spatial_shapes, device)
+        cached = self._shape_cache.get(key)
+        if cached is None:
+            shapes = torch.as_tensor(spatial_shapes, dtype=torch.long, device=device)
+            starts = torch.cat((shapes.new_zeros((1, )), shapes.prod(1).cumsum(0)[:-1]))
+            cached = (shapes, starts)
+            self._shape_cache[key] = cached
+        return cached
