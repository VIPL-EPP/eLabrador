+    for key in _FLEX_ATTENTION_KEYS
+}
+
+
+def _flex_attention_nlc_fp32(q, k, v, score_mod, scale):
+    """Return FlexAttention output in contiguous NLC FP32 layout."""
+    output = flex_attention(q, k, v, score_mod=score_mod, scale=scale)
+    batch, heads, tokens, head_dim = output.shape
+    return (
+        output.transpose(1, 2)
+        .reshape(batch, tokens, heads * head_dim)
+        .to(torch.float32)
+    )
+
+
+_compiled_flex_attention_nlc_fp32_by_key = {
+    key: torch.compile(
+        _flex_attention_nlc_fp32, dynamic=False, fullgraph=True
+    )
+    for key in _FLEX_ATTENTION_KEYS
+}
+
+
+def _shifted_window_partition(x, window_size, shift_size):
+    """Fuse cyclic shift and the BHWC-to-window layout copy."""
+    B, H, W, C = x.shape
+    x = torch.roll(x, shifts=(-shift_size, -shift_size), dims=(1, 2))
+    x = x.view(
+        B,
+        H // window_size,
+        window_size,
+        W // window_size,
+        window_size,
+        C,
+    )
+    return (
+        x.permute(0, 1, 3, 2, 4, 5)
+        .contiguous()
+        .view(-1, window_size * window_size, C)
+    )
+
+
+def _shifted_window_reverse(windows, window_size, H, W, shift_size):
+    """Fuse the window-to-BHWC layout copy and reverse cyclic shift."""
+    windows_per_image = (H // window_size) * (W // window_size)
+    B = windows.shape[0] // windows_per_image
+    x = windows.view(
+        B,
+        H // window_size,
+        W // window_size,
+        window_size,
+        window_size,
+        -1,
+    )
+    x = x.permute(0, 1, 3, 2, 4, 5).contiguous().view(B, H, W, -1)
+    return torch.roll(x, shifts=(shift_size, shift_size), dims=(1, 2))
+
+
+_compiled_shifted_window_partition_by_channels = {
+    channels: torch.compile(
+        _shifted_window_partition, dynamic=False, fullgraph=True
+    )
+    for channels in (192, 384, 768, 1536)
+}
+_compiled_shifted_window_reverse_by_channels = {
+    channels: torch.compile(
+        _shifted_window_reverse, dynamic=False, fullgraph=True
+    )
+    for channels in (192, 384, 768, 1536)
+}
