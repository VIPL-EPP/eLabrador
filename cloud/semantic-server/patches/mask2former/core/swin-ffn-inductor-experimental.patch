 }
 
 
+def _swin_post_attention_ffn(
+    shortcut,
+    attention_output,
+    norm_weight,
+    norm_bias,
+    norm_eps,
+    fc1_weight,
+    fc1_bias,
+    fc2_weight,
+    fc2_bias,
+):
+    """Fuse both residual adds with LayerNorm and the MLP pointwise ops."""
+    residual = shortcut + attention_output
+    normalized = F.layer_norm(
+        residual,
+        (residual.shape[-1],),
+        norm_weight,
+        norm_bias,
+        norm_eps,
+    )
+    hidden = F.gelu(F.linear(normalized, fc1_weight, fc1_bias))
+    return residual + F.linear(hidden, fc2_weight, fc2_bias)
+
+
+_compiled_swin_post_attention_ffn_by_channels = {
+    channels: torch.compile(
+        _swin_post_attention_ffn, dynamic=False, fullgraph=True
+    )
+    for channels in (192, 384, 768, 1536)
+}
+
+
 class Mlp(nn.Module):
     """Multilayer perceptron."""
 
