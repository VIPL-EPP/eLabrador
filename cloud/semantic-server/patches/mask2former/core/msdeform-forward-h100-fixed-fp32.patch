+// Opt-in production-shape path: one warp owns the 32 channels of one
+// (batch, query, head) item. A 2-D grid separates batches, fixed 3x4 sampling
+// loops are unrolled, and the fixed feature pyramid stays in immediates.
+template <typename scalar_t>
+__global__ void ms_deformable_im2col_gpu_kernel_h100_c32(
+                                                const int samples_per_batch,
+                                                const scalar_t *__restrict__ data_value,
+                                                const scalar_t *__restrict__ data_sampling_loc,
+                                                const scalar_t *__restrict__ data_attn_weight,
+                                                const int spatial_size,
+                                                scalar_t *__restrict__ data_col)
+{
+  constexpr int kChannels = 32;
+  constexpr int kHeads = 8;
+  constexpr int kLevels = 3;
+  constexpr int kPoints = 4;
+
+  const int lane = threadIdx.x & (kChannels - 1);
+  const int sampling_in_batch =
+      blockIdx.x * (blockDim.x / kChannels) + threadIdx.x / kChannels;
+  if (sampling_in_batch >= samples_per_batch)
+    return;
+
+  const int b_col = blockIdx.y;
+  const int sampling_index = b_col * samples_per_batch + sampling_in_batch;
+  const int m_col = sampling_in_batch & (kHeads - 1);
+  int data_weight_ptr = sampling_index * kLevels * kPoints;
+  int data_loc_w_ptr = data_weight_ptr << 1;
+  constexpr int qid_stride = kHeads * kChannels;
+  const int data_value_ptr_init_offset = b_col * spatial_size * qid_stride;
+  scalar_t col = 0;
+
+#pragma unroll
+  for (int l_col = 0; l_col < kLevels; ++l_col)
+  {
+    const int level_start_id =
+        l_col == 0 ? 0 : (l_col == 1 ? 768 : 3840);
+    const int spatial_h = 24 << l_col;
+    const int spatial_w = 32 << l_col;
+    const scalar_t *data_value_ptr =
+        data_value + data_value_ptr_init_offset + level_start_id * qid_stride;
+
+#pragma unroll
+    for (int p_col = 0; p_col < kPoints; ++p_col)
+    {
+      const scalar_t loc_w = data_sampling_loc[data_loc_w_ptr];
+      const scalar_t loc_h = data_sampling_loc[data_loc_w_ptr + 1];
+      const scalar_t weight = data_attn_weight[data_weight_ptr];
+      const scalar_t h_im = loc_h * spatial_h - scalar_t(0.5);
+      const scalar_t w_im = loc_w * spatial_w - scalar_t(0.5);
+
+      if (h_im > -1 && w_im > -1 && h_im < spatial_h && w_im < spatial_w)
+      {
+        col = fma(ms_deform_attn_im2col_bilinear_h100_c32(
+                      data_value_ptr, spatial_h, spatial_w,
+                      h_im, w_im, m_col, lane),
+                  weight, col);
+      }
+      ++data_weight_ptr;
+      data_loc_w_ptr += 2;
+    }
+  }
+  data_col[sampling_index * kChannels + lane] = col;
+}
