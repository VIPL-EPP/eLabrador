+template <typename scalar_t>
+__device__ __forceinline__ scalar_t
+ms_deform_attn_im2col_bilinear_h100_c32(
+    const scalar_t *__restrict__ bottom_data,
+    const int height,
+    const int width,
+    const scalar_t h,
+    const scalar_t w,
+    const int m,
+    const int c)
+{
+  constexpr int kHeads = 8;
+  constexpr int kChannels = 32;
+  const int h_low = floor(h);
+  const int w_low = floor(w);
+  const int h_high = h_low + 1;
+  const int w_high = w_low + 1;
+  const scalar_t lh = h - h_low;
+  const scalar_t lw = w - w_low;
+  constexpr int w_stride = kHeads * kChannels;
+  const int h_stride = width * w_stride;
+  const int h_low_ptr_offset = h_low * h_stride;
+  const int h_high_ptr_offset = h_low_ptr_offset + h_stride;
+  const int w_low_ptr_offset = w_low * w_stride;
+  const int w_high_ptr_offset = w_low_ptr_offset + w_stride;
+  const int base_ptr = m * kChannels + c;
+
+  scalar_t v1 = 0, v2 = 0, v3 = 0, v4 = 0;
+  if (h_low >= 0 && h_high < height && w_low >= 0 && w_high < width)
+  {
+    v1 = bottom_data[h_low_ptr_offset + w_low_ptr_offset + base_ptr];
+    v2 = bottom_data[h_low_ptr_offset + w_high_ptr_offset + base_ptr];
+    v3 = bottom_data[h_high_ptr_offset + w_low_ptr_offset + base_ptr];
+    v4 = bottom_data[h_high_ptr_offset + w_high_ptr_offset + base_ptr];
+  }
+  else
+  {
+    if (h_low >= 0 && w_low >= 0)
+      v1 = bottom_data[h_low_ptr_offset + w_low_ptr_offset + base_ptr];
+    if (h_low >= 0 && w_high < width)
+      v2 = bottom_data[h_low_ptr_offset + w_high_ptr_offset + base_ptr];
+    if (h_high < height && w_low >= 0)
+      v3 = bottom_data[h_high_ptr_offset + w_low_ptr_offset + base_ptr];
+    if (h_high < height && w_high < width)
+      v4 = bottom_data[h_high_ptr_offset + w_high_ptr_offset + base_ptr];
+  }
+
+  const scalar_t top = fma(lw, v2 - v1, v1);
+  const scalar_t bottom = fma(lw, v4 - v3, v3);
+  return fma(lh, bottom - top, top);
+}
