# Copy this file to .env and replace the text after each "=" with your value.
# Do not commit .env. The values below are descriptions, not runnable defaults.

# Docker Compose
NVI_CONTAINER_USER=user used to run commands inside the container
NVI_HOST_PORT=host port mapped to container port 80
NVI_GPU_DEVICE_ID=NVIDIA GPU device id exposed to the container
NVI_CONTAINER_NAME=Docker container name for this service

# Mask2Former precision. Keep BF16 opt-in until labelled-set mIoU is validated.
NVI_FLOAT32_MATMUL_PRECISION=high
NVI_AUTOCAST_DTYPE=none
# Non-legacy modes require applying the matching H100/BW1000 bundle with
# apply-mask2former-patches.sh. Use legacy to independently revert each path.
NVI_SWIN_ATTENTION_IMPL=legacy
NVI_SWIN_FFN_IMPL=legacy
NVI_DECODER_POINTWISE_IMPL=legacy
# Fixed-shape MS-Deform modes also require rebuilding its native extension.
NVI_MSDEFORM_IMPL=legacy
NVI_MSDEFORM_NORM_IMPL=legacy
NVI_MSDEFORM_FFN_IMPL=legacy
NVI_UPSAMPLE_POINTWISE_IMPL=legacy
NVI_SEMANTIC_BATCH_IMPL=legacy

# Request-level dynamic batching. Opportunistic early admission is the measured
# production default. Pipeline/adaptive are retained for workload-specific tests.
NVI_MAX_BATCH_SIZE=4
NVI_BATCH_POLICY=opportunistic
NVI_MAX_BATCH_WAIT_MS=0
NVI_BATCH_MAX_QUEUE_DELAY_MS=50
NVI_BATCH_ADAPTIVE_MIN_BATCH_SIZE=2
NVI_BATCH_ADAPTIVE_MAX_MISSES=2
NVI_BATCH_ADAPTIVE_COOLDOWN_MS=5000
NVI_MAX_QUEUE_SIZE=32
NVI_USE_CUDA_GRAPH=true
# H100 uses Graph by default after independent B1-B4 validation. The general
# BW1000 performance profile defaults this switch to false because the formal
# HTTP bracketed A/B only improved c1; when explicitly enabling BW1000 Graph for
# a serial workload, set the limit below to 1 so only B1 is captured and B2-B4
# use eager execution.
NVI_CUDA_GRAPH_MAX_BATCH_SIZE=4
NVI_PREPROC_THREADS=4
NVI_WARMUP_SHAPES=640x480

# Mask2Former response compression. Level 1 keeps NPZ/np.load compatibility while
# reducing CPU time; compression runs outside the event loop on this dedicated pool.
NVI_NPZ_COMPRESSION_LEVEL=1
NVI_COMPRESS_THREADS=4

# Profile only. Adds request scheduler timing, CUDA Events and NVTX ranges.
NVI_PROFILE_SCHEDULER_TIMING=false
