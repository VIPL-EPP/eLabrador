# Copy this file to .env and replace the text after each "=" with your value.
# Do not commit .env. The values below are descriptions, not runnable defaults.

# Docker Compose
NVI_CONTAINER_USER=user used to run commands inside the container
NVI_HOST_PORT=host port mapped to container port 80
NVI_GPU_DEVICE_ID=NVIDIA GPU device id exposed to the container
NVI_CONTAINER_NAME=Docker container name for this service
