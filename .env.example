# Copy this file to .env locally or export these variables in your shell.
# Never commit real credentials, API keys, or machine-specific device paths.

# OpenAI-compatible multimodal/VQA endpoint
OPENAI_API_KEY=<YOUR_OPENAI_OR_COMPATIBLE_API_KEY>
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DashScope ASR
DASHSCOPE_API_KEY=<YOUR_DASHSCOPE_API_KEY>

# AMap / Gaode walking route API. Users must apply for their own key.
AMAP_API_KEY=<YOUR_AMAP_API_KEY>

# Local planning model directory. Put best_rssm_trajectory_model.pth in this directory.
# RSSM checkpoint: https://drive.google.com/file/d/1mid3cVu4RZW96qWVOgOr6-XL6GBNSkLD/view
NVI_LOCAL_PLANNING_MODEL=<PATH_TO_LOCAL_PLANNING_MODEL_DIR>
# Local path roots.
NVI_DATASET_ROOT=data

# Belt and device aliases created by edge/src/NVI/system_config/99-nvi-usb.rules
BELT_BLUETOOTH_MAC=<YOUR_HC05_MAC_ADDRESS>
NVI_BELT_PORT=/dev/ttyBelt

# Optional ROS topic defaults for dummy/offline tests
NVI_IMAGE_TOPIC=/camera/color/image_raw
NVI_COMPRESSED_IMAGE_TOPIC=/camera/color/image_raw/compressed
NVI_SEMANTIC_DUMMY_TOPIC=/semantic_cloud/dummy_objects
NVI_OCR_DUMMY_TOPIC=/ocr

# Mask2Former server endpoints. The default edge detector uses HTTP.
MASK2FORMER_HTTP_URL=<YOUR_MASK2FORMER_HTTP_URL>
# Optional: only needed if you explicitly switch to the non-default WebSocket detector.
MASK2FORMER_WS_URI=<YOUR_MASK2FORMER_WS_URI>
